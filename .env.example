# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="mysql://user:password@localhost:3306/maple2_codex"

PUBLIC_NODE_ENV="development"
PUBLIC_MODELS_URL="http://localhost:3000/glbs/"
# Optional. Falls back to PUBLIC_MODELS_URL.
PUBLIC_IMAGES_URL=""
PUBLIC_GIFS_URL="http://localhost:3000/gifs/"

# Reverse proxy. Behind nginx or Caddy, adapter-node sees the proxy's address unless told which
# header carries the client IP. The rate limiters key on that address, so leaving these unset
# behind a proxy makes every visitor share one limit.
# ADDRESS_HEADER="X-Forwarded-For"
# XFF_DEPTH="1" # number of trusted proxies in front of the app

# Largest request body adapter-node accepts. The default 512K rejects GIF uploads, which carry
# every frame as a base64 PNG. Use a finite size such as 100M. Never use Infinity, which lets a
# single request exhaust server memory.
# BODY_SIZE_LIMIT="100M"

# GIF creation. GIFSKI_PATH defaults to bin/gifski in the app directory. GIFS_OUTPUT_PATH defaults
# to a gifs folder next to the app directory and must be served at PUBLIC_GIFS_URL.
# GIFSKI_PATH="/path/to/gifski"
# GIFS_OUTPUT_PATH="/path/to/gifs"
